function main(workbook: ExcelScript.Workbook, bank: number, account: number) {
    // Obtener el rango actualmente seleccionado en la hoja de calculo.
    let range = workbook.getSelectedRange();
    let values = range.getValues();

    // Obtener el numero de filas del rango seleccionado.
    let rows = range.getRowCount();

    // Variable para almacenar el identificador de cuenta asignado.
    let cuenta = "" as string;

    // Iterar sobre cada fila del rango seleccionado.
    for (let row = 0; row < rows; row++) {
        let banco = values[row][bank] as string;

        // Verificar si la celda del banco no esta vacia.
        if (banco.length !== 0) {
            // Asignar identificadores de ejemplo; reemplazarlos por datos reales solo en el libro local.
            switch (banco) {
                case "SERFIN":
                    cuenta = "CTA_EJEMPLO_SERFIN";
                    break;
                case "BBVA":
                    cuenta = "CTA_EJEMPLO_BBVA";
                    break;
                case "CITI":
                    cuenta = "CTA_EJEMPLO_CITI";
                    break;
                case "HSBC":
                    cuenta = "CTA_EJEMPLO_HSBC";
                    break;
                case "BANORTE":
                    cuenta = "CTA_EJEMPLO_BANORTE";
                    break;
                case "COMPE":
                    cuenta = "CTA_EJEMPLO_COMPE";
                    break;
                default:
                    cuenta = "";
                    break;
            }

            // Asignar el identificador correspondiente a la columna de cuenta.
            values[row][account] = cuenta;
        }
    }

    // Establecer los valores actualizados en el rango seleccionado.
    range.setValues(values);
}
