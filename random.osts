function main(workbook: ExcelScript.Workbook, n: number) {
    // Usar el rango seleccionado por el usuario.
    let range = workbook.getSelectedRange();

    // Obtener el numero de filas y columnas del rango seleccionado.
    let rowCount = range.getRowCount();
    let colCount = range.getColumnCount();

    // Calcular el total de celdas en el rango.
    let totalCells = rowCount * colCount;

    // Verificar si la cantidad de celdas a seleccionar es valida.
    if (n > totalCells) {
        throw new Error("El numero de celdas a seleccionar excede el total disponible en el rango.");
    }

    if (n < 0) {
        throw new Error("El numero de celdas a seleccionar no puede ser negativo.");
    }

    // Crear un conjunto para almacenar indices de celdas seleccionadas aleatoriamente.
    let selectedIndices = new Set<number>();

    // Seleccionar n indices unicos de manera aleatoria.
    while (selectedIndices.size < n) {
        let randomIndex = Math.floor(Math.random() * totalCells);
        selectedIndices.add(randomIndex);
    }

    // Convertir los indices seleccionados en coordenadas de fila y columna.
    selectedIndices.forEach(index => {
        let row = Math.floor(index / colCount);
        let col = index % colCount;
        range.getCell(row, col).getFormat().getFill().setColor("#FFFF00");
    });
}
