function main(workbook: ExcelScript.Workbook, bank: number, edo: number, edo2: number, fecha: number) {
    // Obtener el rango seleccionado en la hoja activa.
    let range = workbook.getSelectedRange();
    let values = range.getValues();

    // Obtener las dimensiones del rango.
    let rows = range.getRowCount();

    // Variable para almacenar el valor de soporte que se asignara a las celdas.
    let soporte = "" as string;

    // Iterar sobre cada fila en el rango seleccionado.
    for (let row = 0; row < rows; row++) {
        let banco = values[row][bank] as string;
        let quincena = values[row][fecha] as string;

        // Verificar si el campo de banco no esta vacio.
        if (banco.length !== 0) {
            // Extraer el mes de la fecha. Se espera un formato dd/mm/yyyy.
            let mes = quincena.toString().substring(3, 5) as string;

            // Asignar referencias de ejemplo; reemplazarlas por claves internas solo en el libro local.
            switch (banco) {
                case "SANTANDER":
                    soporte = "CTA_EJEMPLO_SANTANDER_".concat(mes);
                    break;
                case "BANCOMER":
                    soporte = "CTA_EJEMPLO_BANCOMER_".concat(mes);
                    break;
                case "BANAMEX":
                    soporte = "CTA_EJEMPLO_BANAMEX_".concat(mes);
                    break;
                case "HSBC":
                    soporte = "CTA_EJEMPLO_HSBC_".concat(mes);
                    break;
                case "BANORTE":
                    soporte = "CTA_EJEMPLO_BANORTE_".concat(mes);
                    break;
                default:
                    soporte = "";
                    break;
            }

            // Asignar el valor de soporte a las columnas indicadas por edo y edo2.
            values[row][edo] = soporte;
            values[row][edo2] = soporte;
        }
    }

    // Establecer los valores modificados en el rango seleccionado.
    range.setValues(values);
}
